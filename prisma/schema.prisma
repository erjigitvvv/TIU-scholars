datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String
  role            String         @default("SCHOLAR") // SCHOLAR, MODERATOR, SUPER_ADMIN
  accountStatus   String         @default("PENDING") // PENDING, ACTIVE, REJECTED, SUSPENDED
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt

  scholarProfile  ScholarProfile?
  publications    Publication[]  @relation("SubmittedPublications")
  auditLogs       AuditLog[]
  announcements   Announcement[] @relation("CreatedAnnouncements")
  notifications   Notification[] @relation("UserNotifications")
  academicProjects AcademicProject[] @relation("CreatedAcademicProjects")
  projectCollaborations ProjectCollaborator[]
}

model Faculty {
  id          String       @id @default(cuid())
  code        String       @unique
  nameUz      String
  nameRu      String
  nameEn      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  departments Department[]
}

model Department {
  id          String           @id @default(cuid())
  facultyId   String
  faculty     Faculty          @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  nameUz      String
  nameRu      String
  nameEn      String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  scholars    ScholarProfile[]
  kpiTargets  KpiTarget[]
}

model ScholarProfile {
  id                 String              @id @default(cuid())
  userId             String              @unique
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId       String
  department         Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  fullName           String
  academicDegree     String              @default("NONE") // NONE, PHD, DSC
  academicTitle      String              @default("NONE") // NONE, ASSISTANT, DOCENT, PROFESSOR
  bioUz              String?
  bioRu              String?
  bioEn              String?
  researchInterests  String              @default("[]") // JSON string array
  photoUrl           String?
  publicEmail        String?
  orcidId            String?
  scopusId           String?
  positionUz         String?
  positionRu         String?
  positionEn         String?
  educationUz        String?
  educationRu        String?
  educationEn        String?
  googleScholarUrl   String?
  linkedinUrl        String?
  telegramUrl        String?
  researchGateUrl    String?
  hIndex             Int                 @default(0)
  totalCitations     Int                 @default(0)
  tiuScore           Float               @default(0)
  googleScholarId    String?
  isOrcidConnected   Boolean             @default(false)
  isScopusConnected  Boolean             @default(false)
  isScholarConnected Boolean             @default(false)
  lastAcademicSyncAt DateTime?
  totalCitationsScopus  Int              @default(0)
  totalCitationsScholar Int              @default(0)
  hIndexScopus       Int                 @default(0)
  hIndexScholar      Int                 @default(0)
  i10Index           Int                 @default(0)
  telegramChatId     String?             @unique
  telegramUsername   String?
  telegramConnectedAt DateTime?
  isTelegramConnected Boolean            @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  publications       PublicationAuthor[]
  grantProjects      GrantProject[]
  supervisions       Supervision[]
  kpiTargets         KpiTarget[]
  telegramAuthCodes  TelegramAuthCode[]
  announcementInquiries AnnouncementInquiry[]
}

model Publication {
  id                 String              @id @default(cuid())
  title              String
  type               String              // SCOPUS, WOS, OAK, INTERNATIONAL_JOURNAL, LOCAL_JOURNAL, CONFERENCE, MONOGRAPH, TEXTBOOK, PATENT
  journalOrPublisher String
  year               Int
  doi                String?             @unique
  url                String?
  isbnOrPatentNo     String?
  coverImageUrl      String?             // Maqola muqovasi yoki grafik abstrakt (Graphical Abstract) rasmi
  quartile           String              @default("NONE") // Q1, Q2, Q3, Q4, NONE
  citationsCount     Int                 @default(0)
  isScopusIndexed    Boolean             @default(false)
  isOrcidVerified    Boolean             @default(false)
  isScholarIndexed   Boolean             @default(false)
  scopusEID          String?
  source             String              @default("MANUAL") // MANUAL, ORCID, SCOPUS, SCHOLAR, CROSSREF
  status             String              @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason    String?
  currentStage       String              @default("PUBLISHED") // IDEA, LITERATURE, METHODOLOGY, ANALYSIS, WRITING, PLAGIARISM, SUBMITTED, PEER_REVIEW, REVISION, PUBLISHED
  reviewLogs         String?             // JSON string: [{ id, round, date, decision, comments: [{ reviewer, note, rebuttal }], revisedDocUrl }]
  expertiseActNo     String?             // e.g. "TIU-EXP-2026-0042"
  expertiseActDate   DateTime?
  expertiseActUrl    String?
  submittedById      String
  submittedBy        User                @relation("SubmittedPublications", fields: [submittedById], references: [id], onDelete: Cascade)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  authors            PublicationAuthor[]
  supervisions       SupervisionPublication[]
  qualityCheck       ModeratorQualityCheck?
}

model PublicationAuthor {
  id            String         @id @default(cuid())
  publicationId String
  publication   Publication    @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  scholarId     String
  scholar       ScholarProfile @relation(fields: [scholarId], references: [id], onDelete: Cascade)
  authorOrder   Int            @default(1)
  approvalStatus String        @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedAt    DateTime?
  rejectionNote String?

  @@unique([publicationId, scholarId])
}

model GrantProject {
  id              String         @id @default(cuid())
  scholarId       String
  scholar         ScholarProfile @relation(fields: [scholarId], references: [id], onDelete: Cascade)
  title           String
  role            String         @default("Principal Investigator") // PI, CO_PI, RESEARCHER, CONSULTANT
  fundingSource   String         // Masalan: "Innovatsion rivojlanish agentligi", "Erasmus+", "Horizon Europe"
  grantProgram    String?        // Tanlov yo'nalishi (masalan: "Amaliy tadqiqotlar 2026", "Yosh olimlar", "Fundamental")
  grantCode       String?        // Unikal ariza kodi: "TIU-GRT-2026-0012"
  startYear       Int
  endYear         Int?
  budgetRequested Float?         // So'ralayotgan jami byudjet
  budgetApproved  Float?         // Tasdiqlangan summa
  deadlineDate    DateTime?      // Topshirish muddati
  status          String         @default("DRAFT") // DRAFT, SUBMITTED_INTERNAL, APPROVED_BY_MODERATOR, SUBMITTED_FUNDER, UNDER_EVALUATION, WON, REJECTED, COMPLETED
  rejectionReason String?

  // 8 asosiy ariza bo'limlari (JSON)
  proposalData    String?        // JSON: { urgency, objectives, novelty, methodology, workPlanGantt, teamExperience, risks, impact }
  budgetItems     String?        // JSON: [{ category: "SALARY"|"EQUIPMENT"|"TRAVEL"|"SUPPLIES", title, amount, justification }]
  teamMembers     String?        // JSON: [{ name, email, role, institution, degree, sharePercent }]
  documentsList   String?        // JSON: [{ name, url, status: "UPLOADED"|"REQUIRED" }]

  // Natijalar bog'lanishi (Publications & Deliverables)
  deliverables    String?        // JSON: [{ type: "ARTICLE"|"PATENT"|"CONFERENCE", title, publicationId, status }]

  applicationFileUrl  String?
  applicationFileName String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt
}

model Supervision {
  id                 String         @id @default(cuid())
  scholarId          String
  scholar            ScholarProfile @relation(fields: [scholarId], references: [id], onDelete: Cascade)
  
  // Shogird ma'lumotlari
  studentName        String
  studentEmail       String?
  studentPhone       String?
  degreeType         String         @default("PHD") // MASTER, PHD, DSC, INDEPENDENT_RESEARCHER
  specialtyCode      String?        // Masalan: "05.01.05"
  specialtyName      String?
  dissertationTitle  String
  year               Int            @default(2026)  // Boshlanish yoki bazaviy yil (legacy moslik)

  // Bosqich va Moderatsiya
  stage              String         @default("A_DRAFT") 
  // A_DRAFT, A_SUBMITTED_DEPARTMENT, A_DEPARTMENT_APPROVED, B_ACTIVE_RESEARCH, C_PUBLICATIONS_READY, D_PRE_DEFENSE, E_COMPLETED, ON_HOLD, TERMINATED
  
  status             String         @default("PENDING") // PENDING, APPROVED, REJECTED (Reyting kodi shunga tayanadi)
  rejectionReason    String?

  // Qonuniy buyruq
  orderNumber        String?        // Rektor buyrug'i raqami
  orderDate          DateTime?      // Buyruq sanasi
  orderFileUrl       String?        // PDF buyruq nusxasi
  
  // Muddatlar
  startDate          DateTime?      // Buyruq chiqqan sana
  expectedDefenseDate DateTime?     // Rejalashtirilgan himoya sanasi
  actualDefenseDate  DateTime?      // Haqiqiy himoya sanasi
  defenseCouncilNo   String?        // Kengash raqami (masalan: DSc.03/30.12.2021.T.02.05)
  diplomaNumber      String?        // OAK diplomi raqami
  diplomaFileUrl     String?
  
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @default(now()) @updatedAt

  // Munosabatlar
  milestones         SupervisionMilestone[]
  meetings           SupervisionMeeting[]
  reports            SupervisionReport[]
  publications       SupervisionPublication[]
  checklist          SupervisionChecklist?
  documents          DocumentVersion[]

  @@index([scholarId])
  @@index([stage])
  @@index([status])
}

model SupervisionMilestone {
  id             String      @id @default(cuid())
  supervisionId  String
  supervision    Supervision @relation(fields: [supervisionId], references: [id], onDelete: Cascade)
  title          String      // masalan: "1-yilgi Qishki Attestatsiya"
  stage          String      // Qaysi bosqichga tegishliligi
  dueDate        DateTime    // Belgilangan oxirgi muddat
  completedDate  DateTime?   // Haqiqiy bajarilgan sana
  isCompleted    Boolean     @default(false)
  isOverdue      Boolean     @default(false)
  notes          String?
  createdAt      DateTime    @default(now())

  @@index([supervisionId])
  @@index([dueDate])
}

model SupervisionMeeting {
  id              String      @id @default(cuid())
  supervisionId   String
  supervision     Supervision @relation(fields: [supervisionId], references: [id], onDelete: Cascade)
  meetingDate     DateTime    @default(now())
  topicsCovered   String      // Muhokama qilingan masalalar
  tasksAssigned   String      // Shogirdga berilgan topshiriqlar
  nextMeetingDate DateTime?
  notes           String?
  createdAt       DateTime    @default(now())

  @@index([supervisionId])
}

model SupervisionReport {
  id             String      @id @default(cuid())
  supervisionId  String
  supervision    Supervision @relation(fields: [supervisionId], references: [id], onDelete: Cascade)
  periodName     String      // masalan: "2026/2027 1-yarim yillik"
  submittedAt    DateTime    @default(now())
  content        String      // Bajarilgan ishlar hisoboti
  fileUrl        String?     // PDF hisobot fayli
  status         String      @default("PENDING") // PENDING, ACCEPTED, NEEDS_REVISION
  feedback       String?
  reviewedAt     DateTime?
  reviewedBy     String?

  @@index([supervisionId])
}

model SupervisionPublication {
  id             String      @id @default(cuid())
  supervisionId  String
  supervision    Supervision @relation(fields: [supervisionId], references: [id], onDelete: Cascade)
  publicationId  String
  publication    Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  addedAt        DateTime    @default(now())

  @@unique([supervisionId, publicationId])
  @@index([supervisionId])
}

model SupervisionChecklist {
  id                  String      @id @default(cuid())
  supervisionId       String      @unique
  supervision         Supervision @relation(fields: [supervisionId], references: [id], onDelete: Cascade)
  dissertationFileUrl String?
  isDissertationReady Boolean     @default(false)
  autoreferatFileUrl  String?
  isAutoreferatReady  Boolean     @default(false)
  seminarProtocolUrl  String?
  isSeminarApproved   Boolean     @default(false)
  plagiarismReportUrl String?
  plagiarismPercent   Float?      // Masalan: 88.5%
  isPlagiarismPassed  Boolean     @default(false)
  allRequirementsMet  Boolean     @default(false)
  updatedAt           DateTime    @updatedAt
}

model KpiTarget {
  id                String          @id @default(cuid())
  year              Int
  departmentId      String?
  department        Department?     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  scholarId         String?
  scholar           ScholarProfile? @relation(fields: [scholarId], references: [id], onDelete: Cascade)
  targetPublications Int
  targetScopus      Int
  targetScore       Float
  createdAt         DateTime        @default(now())
}

model ScoringConfig {
  id                String  @id @default(cuid())
  scopusWeight      Float   @default(10)
  q1Q2Bonus         Float   @default(5)
  wosWeight         Float   @default(10)
  oakWeight         Float   @default(5)
  monographWeight   Float   @default(7)
  patentWeight      Float   @default(6)
  conferenceWeight  Float   @default(2)
  citationWeight    Float   @default(0.2)
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action    String
  entityType String
  entityId  String
  details   String?  // JSON string
  createdAt DateTime @default(now())
}

model Announcement {
  id         String    @id @default(cuid())
  title      String
  content    String
  category   String    @default("NEWS") // GRANT, CONFERENCE, DEADLINE, NEWS
  visibility String    @default("PUBLIC") // PUBLIC, INTERNAL
  status     String    @default("PUBLISHED") // PUBLISHED, DRAFT, ARCHIVED
  isPinned   Boolean   @default(false)
  deadline   DateTime?
  viewsCount Int       @default(0)
  authorId   String
  author     User      @relation("CreatedAnnouncements", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  inquiries  AnnouncementInquiry[]
}

model AnnouncementInquiry {
  id              String         @id @default(cuid())
  announcementId  String
  announcement    Announcement   @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  scholarId       String?
  scholar         ScholarProfile? @relation(fields: [scholarId], references: [id], onDelete: SetNull)
  telegramChatId  String?
  authorName      String
  questionText    String
  answerText      String?
  answeredAt      DateTime?
  answeredById    String?
  status          String         @default("PENDING") // PENDING, ANSWERED
  createdAt       DateTime       @default(now())

  @@index([announcementId])
  @@index([scholarId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("INFO")
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model DocumentVersion {
  id              String      @id @default(cuid())
  supervisionId   String
  supervision     Supervision @relation(fields: [supervisionId], references: [id], onDelete: Cascade)
  documentType    String      // DISSERTATION, AUTOREFERAT, REPORT, SYLLABUS, ARTICLE
  versionNumber   Int         // 1, 2, 3 ...
  fileUrl         String
  fileName        String
  fileSize        Int?        // Hajmi baytlarda
  uploaderNotes   String?     // Izlanuvchi izohi
  uploadedById    String
  createdAt       DateTime    @default(now())

  // Rahbar qarori
  reviewDecision  String?     // APPROVED, NEEDS_REVISION, REJECTED
  reviewComment   String?
  reviewedAt      DateTime?

  @@index([supervisionId, documentType])
}

model ModeratorQualityCheck {
  id                  String       @id @default(cuid())
  publicationId       String       @unique
  publication         Publication  @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  
  // 1. Plagiat
  plagiarismPercent   Float?
  plagiarismReportUrl String?
  isPlagiarismPassed  Boolean      @default(false)

  // 2. Iqtibos formati
  citationFormatStyle String?      // APA, IEEE, HARVARD, OTHER
  isCitationValid     Boolean      @default(false)

  // 3. DOI Haqiqiyligi
  isDoiVerified       Boolean      @default(false)
  crossrefRawData     String?      // JSON string

  // 4. Grammatika va til
  languageQuality     String?      // EXCELLENT, ACCEPTABLE, NEEDS_EDITING
  languageNotes       String?

  moderatorId         String?
  checkedAt           DateTime?
  createdAt           DateTime     @default(now())
}

model TelegramAuthCode {
  id         String         @id @default(cuid())
  scholarId  String
  scholar    ScholarProfile @relation(fields: [scholarId], references: [id], onDelete: Cascade)
  code       String         @unique
  expiresAt  DateTime
  createdAt  DateTime       @default(now())

  @@index([code])
  @@index([scholarId])
}

model EmailVerificationCode {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  code      String
  purpose   String   @default("CHANGE_EMAIL") // CHANGE_EMAIL, RESET_PASSWORD
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([code])
}

model AcademicProject {
  id               String                @id @default(cuid())
  code             String                @unique // Masalan: TIU-ART-2026-0001
  title            String
  type             String                @default("ARTICLE") // ARTICLE, THESIS, DISSERTATION, AUTOREFERAT, MONOGRAPH, GRANT
  status           String                @default("DRAFT") // DRAFT, IN_REVIEW, REVISION, SUBMITTED, PUBLISHED, AWARDED, REJECTED
  abstract         String?
  keywords         String?
  targetJournal    String?
  targetConference String?
  grantFunder      String?
  budgetTotal      Float?
  doi              String?
  contentBlocks    String?               // JSON string of IMRAD sections or custom content
  referencesList   String?               // JSON string of citations with DOI metadata
  creatorId        String
  creator          User                  @relation("CreatedAcademicProjects", fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  collaborators    ProjectCollaborator[]
  versions         ProjectVersion[]

  @@index([creatorId])
  @@index([type])
  @@index([status])
}

model ProjectCollaborator {
  id              String           @id @default(cuid())
  projectId       String
  project         AcademicProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  scholarEmail    String           // Taklif yuborilgan email
  scholarName     String?
  role            String           @default("CO_AUTHOR") // CORRESPONDING, FIRST_AUTHOR, CO_AUTHOR, SUPERVISOR, CONSULTANT
  creditRoles     String?          // JSON array string: ["Conceptualization", "Methodology", "Writing - original draft"]
  sharePercent    Float            @default(0.0) // 0 - 100%
  assignedSection String?          // Qaysi bo'lim (masalan, "Metodologiya", "Adabiyotlar tahlili")
  inviteStatus    String           @default("PENDING") // PENDING, ACCEPTED, REJECTED
  inviteToken     String?          @unique
  consentSignedAt DateTime?
  rejectReason    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([projectId, scholarEmail])
  @@index([projectId])
  @@index([scholarEmail])
  @@index([inviteStatus])
}

model ProjectVersion {
  id              String           @id @default(cuid())
  projectId       String
  project         AcademicProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versionTag      String           // "v1.0", "v1.1", "v2.0"
  fileUrl         String?
  fileName        String?
  fileSize        Int?
  changesSummary  String?
  createdById     String
  createdAt       DateTime         @default(now())

  @@index([projectId])
}


